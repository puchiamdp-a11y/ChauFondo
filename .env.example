# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chaufondo_db

# JWT
JWT_SECRET=your-secret-key-here-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Environment
ENVIRONMENT=development

# Mercado Pago (optional for FASE 5)
MERCADO_PAGO_TOKEN=
MERCADO_PAGO_SECRET=
MERCADO_PAGO_PUBLIC_KEY=

# File Upload
MAX_UPLOAD_SIZE_MB=25
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Image Processing
REMBG_TIMEOUT_SECONDS=20
REMBG_MODEL=u2net

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO

# Rate Limiting (FASE 4)
FREE_TIER_UPLOADS_PER_DAY=5
FREE_TIER_DOWNLOADS_PER_DAY=5
PREMIUM_TIER_UPLOADS_PER_MONTH=100

# Redis (optional for production rate limiting)
USE_REDIS=false
REDIS_URL=redis://localhost:6379
