# Railway Environment Configuration
# Copy this template to Railway environment variables in the dashboard

# Database (Railway PostgreSQL service)
# DATABASE_URL will be auto-populated by Railway PostgreSQL plugin
# DATABASE_URL=postgresql://user:password@host:5432/chaufondo_db

# JWT Configuration
JWT_SECRET=your-production-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Environment
ENVIRONMENT=production

# Mercado Pago Credentials (get from https://www.mercadopago.com.ar/account)
MERCADO_PAGO_TOKEN=your-mercado-pago-access-token
MERCADO_PAGO_SECRET=your-mercado-pago-secret
MERCADO_PAGO_PUBLIC_KEY=your-mercado-pago-public-key

# Application URLs (update with Railway domain)
API_BASE_URL=https://your-railway-domain.railway.app
FRONTEND_URL=https://your-frontend-domain.com

# File Upload
MAX_UPLOAD_SIZE_MB=25
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Image Processing
REMBG_TIMEOUT_SECONDS=20
REMBG_MODEL=u2net

# CORS
CORS_ORIGINS=https://your-frontend-domain.com

# Logging
LOG_LEVEL=INFO

# Rate Limiting
FREE_TIER_UPLOADS_PER_DAY=5
FREE_TIER_DOWNLOADS_PER_DAY=5
PREMIUM_TIER_UPLOADS_PER_MONTH=100

# Redis (optional, for distributed rate limiting)
USE_REDIS=false
REDIS_URL=redis://localhost:6379
